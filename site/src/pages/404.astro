---
import BaseLayout from '../components/BaseLayout.astro';
import Mark from '../components/Mark.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Page not found — Oigo"
  description="That URL is not on the Oigo site."
  navigation
  noindex
>
  <div class="not-found page-width">
    <Mark size="large" label="Oigo mark" />
    <p class="overline">404</p>
    <h1>Page not found</h1>
    <p>That URL isn’t on this site.</p>
    <a class="button-primary" href={base}>Back to Oigo</a>
  </div>
</BaseLayout>

<style>
  .page-width {
    width: min(100% - 80px, 1060px);
    margin-inline: auto;
  }
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-24) 0;
    text-align: center;
  }
  .not-found h1 {
    max-width: 720px;
    margin: 0 0 var(--space-5);
    color: var(--color-text-primary);
    font-size: 56px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .not-found p:not(.overline) {
    max-width: 560px;
    margin: 0 0 var(--space-10);
    color: var(--color-text-secondary);
    font-size: 19px;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .page-width {
      width: min(100% - 32px, 1060px);
    }
    .not-found {
      padding-top: var(--space-20);
    }
    .not-found h1 {
      font-size: clamp(40px, 11vw, 56px);
    }
  }
</style>
