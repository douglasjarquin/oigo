---
import Mark from './Mark.astro';

const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-brand">
      <Mark size="small" />
      <span>Oigo — “¿Oigo?” · I can hear you.</span>
    </span>
    <span class="footer-spacer"></span>
    <a href="https://github.com/douglasjarquin/oigo">GitHub</a>
    <a href="https://github.com/douglasjarquin/oigo/releases">Releases</a>
    <a href="https://github.com/douglasjarquin/oigo/blob/main/LICENSE">MIT License</a>
    <a href={`${base}#privacy`}>Privacy</a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-hairline); }
  .footer-inner { width: min(100% - 80px, 1060px); min-height: 84px; margin-inline: auto; gap: var(--space-6); }
  .footer-inner a, .footer-brand { color: var(--color-text-muted); font-size: 12.5px; }
  .footer-brand { display: flex; align-items: center; gap: var(--space-2); }
  @media (max-width: 760px) { .footer-inner { width: min(100% - 32px, 1060px); align-items: flex-start; flex-wrap: wrap; gap: var(--space-3) var(--space-4); padding: var(--space-6) 0; } .footer-spacer { display: none; } }
</style>
